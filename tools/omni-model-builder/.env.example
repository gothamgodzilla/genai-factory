# Omni CLI authentication. Prefer a profile (`omni config login`) when you
# can complete a browser flow. In headless or CI use a personal token.
# OMNI_API_TOKEN=
# OMNI_BASE_URL=https://your-org.omniapp.co
# Optional override when `omni` is not on PATH.
# OMNI_BIN=/usr/local/bin/omni

# eve model credentials. Use Vercel AI Gateway or an installed /login session.
# AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=
